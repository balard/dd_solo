{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dice.schema.json",
  "title": "Dragon Dice unit die data",
  "description": "Generated by tools/import_faces.py from data/raw/*.faces.txt. Do not hand-edit.",
  "type": "object",
  "required": ["species", "units"],
  "properties": {
    "$schema": { "type": "string" },
    "_generated": { "type": "string" },
    "species": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "elements"],
        "properties": {
          "name": { "type": "string" },
          "elements": {
            "type": "array",
            "items": { "enum": ["air", "water", "earth", "fire", "death", "ivory"] },
            "minItems": 1,
            "maxItems": 2
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "species", "class", "size", "health", "dieType", "faces"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
          "name": { "type": "string" },
          "species": { "type": "string" },
          "class": { "enum": ["heavy_melee", "light_melee", "cavalry", "missile", "magic"] },
          "size": { "enum": ["small", "medium", "large", "monster"] },
          "health": { "type": "integer", "minimum": 1, "maximum": 4 },
          "dieType": { "enum": ["d6", "d10"] },
          "faces": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "'<count> <ICON>' where ICON is a normal action icon, or '<count> SAI:<Name>'. The count is how many icons are printed on that face; for most SAIs it is the SAI's X parameter instead.",
              "pattern": "^(\\d+ (ID|MELEE|MISSILE|MAGIC|SAVE|MANEUVER)|\\d+ SAI:[A-Za-z][A-Za-z ]*|TODO)$"
            }
          }
        }
      }
    }
  }
}
