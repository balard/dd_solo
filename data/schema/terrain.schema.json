{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terrain.schema.json",
  "title": "Dragon Dice terrain die data",
  "description": "Generated by tools/import_terrains.py from data/raw/terrains.faces.txt. Do not hand-edit. A terrain die is a terrain type (which fixes faces 1-7) plus an eighth-face icon.",
  "type": "object",
  "required": ["terrainTypes", "terrains"],
  "properties": {
    "$schema": { "type": "string" },
    "_generated": { "type": "string" },
    "_comment": { "type": "string" },
    "terrainTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "elements", "faces"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "elements": {
            "type": "array",
            "items": { "enum": ["air", "water", "earth", "fire", "death"] },
            "minItems": 1,
            "maxItems": 2
          },
          "faces": {
            "type": "object",
            "description": "Keyed by the number printed on the face, 1-7. Face 8 comes from the die's eighthFace.",
            "required": ["1", "2", "3", "4", "5", "6", "7"],
            "additionalProperties": false,
            "patternProperties": {
              "^[1-7]$": { "enum": ["MELEE", "MISSILE", "MAGIC"] }
            }
          }
        }
      }
    },
    "terrains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "eighthFace"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "type": { "type": "string" },
          "eighthFace": { "enum": ["city", "standing_stones", "temple", "tower"] }
        }
      }
    }
  }
}
