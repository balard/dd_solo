{
  "name": "dd-solo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Solo-play app for Dragon Dice",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data": "python tools/import_faces.py && python tools/import_terrains.py && python tools/validate_data.py",
    "play": "vite-node src/cli/play.ts",
    "goldens": "vite-node src/cli/goldens.ts",
    "art": "python tools/fetch_faces.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
